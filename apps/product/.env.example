# ==============================================================================
# Product Service Environment Configuration (.env.example)
# Copy to .env.development or .env.production
# ==============================================================================

# Runtime Environment
NODE_ENV=development

# Service Binding
SERVICE_HOST_NAME=localhost
SERVICE_PORT=3001

# PostgreSQL Database (Database-per-service pattern)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=bookworm_product

# RabbitMQ AMQP Broker & Client Queues
RABBIT_MQ_URI=amqp://guest:guest@localhost:5672
AUTH_QUEUE=auth_queue
PRODUCT_QUEUE=product_queue
CART_QUEUE=cart_queue
ORDER_QUEUE=order_queue

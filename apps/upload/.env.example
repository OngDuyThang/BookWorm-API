# ==============================================================================
# Upload Service Environment Configuration (.env.example)
# Copy to .env.development or .env.production
# ==============================================================================

# Runtime Environment
NODE_ENV=development

# Service Binding
SERVICE_HOST_NAME=localhost
SERVICE_PORT=3004

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Amazon Web Services (AWS S3) Configuration (Optional / Legacy v1)
AWS_S3_REGION=us-east-1
AWS_S3_BUCKET=bookworm-assets
AWS_ACCESS_KEY=your_aws_access_key_id
AWS_SECRET_KEY=your_aws_secret_access_key


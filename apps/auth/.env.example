# ==============================================================================
# Auth Service Environment Configuration (.env.example)
# Copy to .env.development or .env.production
# ==============================================================================

# Runtime Environment
NODE_ENV=development

# Service Binding
SERVICE_HOST_NAME=localhost
SERVICE_PORT=3000

# PostgreSQL Database (Database-per-service pattern)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=bookworm_auth

# RabbitMQ AMQP Broker & Queue
RABBIT_MQ_URI=amqp://guest:guest@localhost:5672
AUTH_QUEUE=auth_queue

# Redis Cache (Session tokens, OTP & short-lived auth codes)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=

# JWT Secrets (Use strong, randomly generated keys in production)
ACCESS_TOKEN_SECRET=your_jwt_access_token_secret_key_here
REFRESH_TOKEN_SECRET=your_jwt_refresh_token_secret_key_here

# Auth Endpoints / View Paths
VALIDATE_OTP_PATH_NAME=/auth/validate-otp
RESET_PASSWORD_PATH_NAME=/auth/reset-password

# Email Transporter (Nodemailer for password resets)
MAILER_USERNAME=your_email@gmail.com
MAILER_PASSWORD=your_email_app_password

# Google OAuth2 Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
GOOGLE_ISSUER=accounts.google.com

# Client Application Callback Hosts
FRONTEND_HOST_NAME=localhost
FRONTEND_PORT=3006
MVC_HOST_NAME=localhost
MVC_PORT=8081

# Initial Admin User Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123456

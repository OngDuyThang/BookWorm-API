PRODUCT_SERVICE_PORT=3001

CART_SERVICE_HOST_NAME=localhost
CART_SERVICE_PORT=3002

ORDER_SERVICE_HOST_NAME=localhost
ORDER_SERVICE_PORT=3003

UPLOAD_SERVICE_HOST_NAME=localhost
UPLOAD_SERVICE_PORT=3004

ASSET_SERVICE_HOST_NAME=localhost
ASSET_SERVICE_PORT=3005

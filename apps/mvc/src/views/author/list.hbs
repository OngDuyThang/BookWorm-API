<!DOCTYPE html>
<html lang="en">
{{> head }}

<body>
    {{> sidebar }}
    <main>
        {{> header }}
        <section class="mt-[68px] p-4 overflow-x-scroll">
            <div class="flex justify-between items-center space-x-4 pb-8">
                <h1 class="font-bold text-lg">Authors</h1>
                <a href="/authors/create">
                    <button type="button"
                        class="text-green-500 inline-flex items-center hover:text-white border border-green-500 hover:bg-green-500 focus:ring-4 focus:outline-none focus:ring-green-500 font-semibold rounded-lg text-sm px-5 py-2.5 text-center">
                        <i class="fa-solid fa-plus mr-2"></i> Create New Author
                    </button>
                </a>
            </div>
            <table id="authors-table" class="w-full">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Pen Name</th>
                        <th>Created At</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody class="authors-table-body"></tbody>
            </table>
        </section>
        {{> footer }}
    </main>

    <script>
        const authors = {{ json authors }}
        const removeUrl = {{ json removeUrl }}

        $(document).ready(async () => {
            const authorsBody = $('.authors-table-body');
            authors?.forEach((author) => {
                const createdAt = author?.created_at ? new Date(author.created_at).toLocaleDateString() : 'N/A';
                authorsBody.append(`
                    <tr>
                        <td class="text-xs font-mono text-gray-500">${author?.id}</td>
                        <td class="font-medium text-gray-900">${author?.pen_name || 'Unnamed'}</td>
                        <td>${createdAt}</td>
                        <td class='flex gap-4 items-center'>
                            <a href='/authors/${author?.id}' title="Edit Author">
                                <button class="p-1 hover:bg-gray-100 rounded">
                                    <i class="fa-solid fa-pen-to-square text-green-500"></i>
                                </button>
                            </a>
                            <button onclick="remove(this)" value="${author?.id}" title="Delete Author" class="p-1 hover:bg-gray-100 rounded">
                                <i class="fa-solid fa-trash text-red-500"></i>
                            </button>
                        </td>
                    </tr>
                `);
            });

            $('#authors-table').DataTable({
                pageLength: 10,
                lengthMenu: [5, 10, 25, 50],
            });
        });

        const remove = async (element) => {
            const id = element?.value || event?.currentTarget?.value;
            if (!id) return;
            if (!confirm('Are you sure you want to delete this author?')) return;

            const accessToken = localStorage.getItem('access_token');
            try {
                const res = await fetch(`${removeUrl}/${id}`, {
                    method: 'DELETE',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${accessToken}`
                    },
                    credentials: 'include'
                });
                const data = await res.json();
                toast(data);
                setTimeout(() => {
                    window.location.reload();
                }, 800);
            } catch (e) {
                console.error(e);
            }
        };
    </script>
    {{> common }}
</body>

</html>

# ==============================================================================
# BookWorm-API — Global Environment Configuration Example (.env.example)
# ==============================================================================
# NOTE: In this monorepo, each microservice loads its own configuration from:
#   apps/<service_name>/.env.${NODE_ENV} (e.g. apps/auth/.env.development)
#
# Dedicated .env.example templates exist inside each app folder:
#   - apps/auth/.env.example
#   - apps/product/.env.example
#   - apps/cart/.env.example
#   - apps/order/.env.example
#   - apps/upload/.env.example
#   - apps/asset/.env.example
#   - apps/mvc/.env.example
#
# Below is a consolidated reference for running services locally or via Docker.
# ==============================================================================

# Global Environment
NODE_ENV=development

# ------------------------------------------------------------------------------
# Common Infrastructure
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres

RABBIT_MQ_URI=amqp://guest:guest@localhost:5672
AUTH_QUEUE=auth_queue
PRODUCT_QUEUE=product_queue
CART_QUEUE=cart_queue
ORDER_QUEUE=order_queue

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# Auth Service (Port 3000)
# ------------------------------------------------------------------------------
AUTH_DB_NAME=bookworm_auth
ACCESS_TOKEN_SECRET=your_jwt_access_token_secret_key_here
REFRESH_TOKEN_SECRET=your_jwt_refresh_token_secret_key_here
VALIDATE_OTP_PATH_NAME=/auth/validate-otp
RESET_PASSWORD_PATH_NAME=/auth/reset-password
MAILER_USERNAME=your_email@gmail.com
MAILER_PASSWORD=your_email_app_password
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
GOOGLE_ISSUER=accounts.google.com
FRONTEND_HOST_NAME=localhost
FRONTEND_PORT=3006
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123456

# ------------------------------------------------------------------------------
# Product Service (Port 3001)
# ------------------------------------------------------------------------------
PRODUCT_DB_NAME=bookworm_product

# ------------------------------------------------------------------------------
# Cart Service (Port 3002)
# ------------------------------------------------------------------------------
CART_DB_NAME=bookworm_cart

# ------------------------------------------------------------------------------
# Order Service (Port 3003)
# ------------------------------------------------------------------------------
ORDER_DB_NAME=bookworm_order
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# ------------------------------------------------------------------------------
# Upload Service (Port 3004)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
AWS_S3_REGION=us-east-1
AWS_S3_BUCKET=bookworm-assets
AWS_ACCESS_KEY=your_aws_access_key_id
AWS_SECRET_KEY=your_aws_secret_access_key


# ------------------------------------------------------------------------------
# Asset Service (Port 3005)
# ------------------------------------------------------------------------------
ASSET_DB_NAME=bookworm_asset
ABOUT_PAGE_ID=

# ------------------------------------------------------------------------------
# Admin MVC Dashboard (Port 8081)
# ------------------------------------------------------------------------------
PORT=8081
METHOD=http
